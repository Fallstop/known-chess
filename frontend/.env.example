# Copy to .env for local dev; set these in the Cloudflare Pages build
# environment for deployment.

PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxx
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Rust backend origin, e.g. https://api.example.com (no trailing slash).
# Empty = same-origin /api, which the Vite dev proxy forwards (dev only).
# REQUIRED (non-empty) for the Cloudflare Pages deployment.
PUBLIC_KC_API_URL=

# Which game this build serves: "precedent" (default) or "unprecedented".
# Empty/unset = precedent. The second Cloudflare Pages project sets this to
# "unprecedented" and points PUBLIC_KC_API_URL at the same shared backend.
PUBLIC_KC_MODE=precedent
